{
  "name": "@chainpearc/cli",
  "version": "3.1.2",
  "description": "ChainPe Provider CLI — Monetize any API with x402 micropayments on Arc",
  "type": "module",
  "bin": {
    "chainpe": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamyaDeb/ChainPe.git",
    "directory": "packages/chainpe"
  },
  "bugs": {
    "url": "https://github.com/SamyaDeb/ChainPe/issues"
  },
  "homepage": "https://github.com/SamyaDeb/ChainPe#readme",
  "author": "ChainPe",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "x402",
    "arc",
    "circle",
    "proxy",
    "micropayments",
    "pay-per-request",
    "http-402",
    "blockchain",
    "usdc",
    "api-monetization",
    "reverse-proxy",
    "ai-agents"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^4.0.0",
    "@clack/prompts": "^0.9.1",
    "@x402/core": "^2.30.0",
    "@x402/evm": "^2.30.0",
    "@x402/express": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.22.3",
    "gradient-string": "^3.0.0",
    "http-proxy-middleware": "^3.0.10",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^22.15.21",
    "ajv": "^8.20.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
