{
  "name": "@chainpearc/agent",
  "version": "3.1.0",
  "description": "ChainPe Agent: an AI agent that finds, pays for and uses x402 services in USDC on Arc.",
  "type": "module",
  "bin": {
    "chainpe-agent": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamyaDeb/ChainPe.git",
    "directory": "packages/chainpe-agent"
  },
  "bugs": {
    "url": "https://github.com/SamyaDeb/ChainPe/issues"
  },
  "homepage": "https://github.com/SamyaDeb/ChainPe#readme",
  "author": "ChainPe",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "x402",
    "arc",
    "circle",
    "usdc",
    "ai-agent",
    "sdk",
    "micropayments",
    "pay-per-request",
    "vercel-ai-sdk",
    "openai",
    "anthropic",
    "chainpe"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.70",
    "@ai-sdk/google": "^2.0.62",
    "@ai-sdk/openai": "^2.0.100",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@chainpearc/sdk": "^0.4.0",
    "@clack/prompts": "^0.9.1",
    "ai": "^6.0.116",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "gradient-string": "^3.0.0",
    "keytar": "^7.9.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "viem": "^2.57.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
