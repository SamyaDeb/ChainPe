{
  "name": "@chainpearc/sdk",
  "version": "0.4.0",
  "description": "ChainPe SDK: pay x402 APIs in USDC on Arc, find services through Circle Discovery, and rate them with ERC-8004.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^4.0.0",
    "@x402/evm": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "keywords": [
    "x402",
    "sdk",
    "usdc",
    "arc",
    "circle",
    "payments",
    "micropayments",
    "ai-agents",
    "erc-8004",
    "reputation",
    "chainpe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamyaDeb/ChainPe.git"
  },
  "engines": {
    "node": ">=22.18"
  }
}
