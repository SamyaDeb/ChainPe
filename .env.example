# ChainPe environment variables (Arc)
# Copy to .env and fill in your values. NEVER commit your real .env.
# The legacy Hardhat contracts have their own templates in contracts/.

# Network: arc-testnet or arc. Use arc-testnet: nothing has been tested on Arc mainnet.
CHAINPE_NETWORK=arc-testnet

# ============================================================================
# SELLING (chainpe CLI)
# ============================================================================

# Payout wallet key. Its address must equal walletAddress (payTo) in the config.
CHAINPE_SELLER_PRIVATE_KEY=

# Optional: CLI config file (default ~/.chainpe/config.json)
# CHAINPE_CONFIG=

# Optional: Circle account key, once the keyless trial is used up
# CIRCLE_API_KEY=

# Optional: Circle Gateway API (nanopayments). The default follows the network:
#   arc-testnet: https://gateway-api-testnet.circle.com
#   arc:         https://gateway-api.circle.com
# CIRCLE_GATEWAY_URL=

# Optional: ChainPeAccounts on arc-testnet. Default is the deployed contract.
# CHAINPE_ACCOUNTS_ADDRESS=0xD315322c9D83A6f50A04236A2a242e0259bfB580

# On a hosted proxy, set these from the values `chainpe login` saves.
# CHAINPE_CLOUD_URL=https://chainpe-cloud-production.up.railway.app
# CHAINPE_INGEST_KEY=

# ============================================================================
# BUYING (chainpe fetch, @chainpearc/sdk, @chainpearc/wallet-mcp)
# ============================================================================

# Buyer key. Use a test wallet, and fund it at https://faucet.circle.com (Arc Testnet).
CHAINPE_PRIVATE_KEY=

# Limits for the MCP wallet (USDC)
MAX_PER_CALL=0.10
MAX_PER_DAY=20.00

# ============================================================================
# ARC RESOURCES
# ============================================================================
# Optional RPC overrides
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# ARC_RPC_URL=https://rpc.mainnet.arc.io
#
# Faucet:           https://faucet.circle.com  (USDC also pays gas on Arc)
# Testnet explorer: https://explorer.testnet.arc.io
# Mainnet explorer: https://explorer.arc.io
