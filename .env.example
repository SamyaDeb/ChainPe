# ChainPe Environment Variables (Avalanche C-Chain)
# Copy to .env and fill in your values.  NEVER commit your real .env.
#
# .env is gitignored. Secrets (private keys) live ONLY here, never in source.

# ============================================================================
# CONTRACT DEPLOYMENT (packages: contracts/ — Hardhat)
# ============================================================================

# Funded deployer private key (0x-prefixed, 64 hex chars). Used by hardhat.config.ts
# to sign deployments to Fuji/mainnet. KEEP SECRET.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Snowtrace/Routescan API key for contract verification (optional; Routescan
# works keyless for most cases).
SNOWTRACE_API_KEY=

# RPC overrides (optional — sensible public defaults are used if unset)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Registry constructor params (optional — deploy.ts has defaults)
# FEE_TOKEN_ADDRESS defaults to the canonical USDC for the target network:
#   Fuji:    0x5425890298aed601595a70AB815c96711a31Bc65
#   Mainnet: 0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
FEE_TOKEN_ADDRESS=
FEE_RECIPIENT=                 # treasury for registration fees (defaults to deployer)
REGISTRATION_FEE_USDC=1.0      # human-readable USDC fee per register/update
IDENTITY_REGISTRY=             # ERC-8004 Identity Registry address (optional)

# ============================================================================
# PROVIDER CONFIGURATION (chainpe CLI)  — migrated in a later phase
# ============================================================================

# Your Avalanche wallet address (0x...) that receives payments.
CHAINPE_WALLET_ADDRESS=0xYOUR_AVALANCHE_ADDRESS

# Backend API URL to proxy
CHAINPE_TARGET=http://localhost:3000

# Price per request (in USDC or AVAX)
CHAINPE_PRICE=0.01

# Payment token: USDC or AVAX
CHAINPE_TOKEN=USDC

# Service metadata
CHAINPE_SERVICE_NAME=My AI Service
CHAINPE_SERVICE_DESCRIPTION=An AI-powered service
CHAINPE_TAGS=ai,nlp,research

# Proxy port
CHAINPE_PORT=4402

# Network: fuji or avalanche
CHAINPE_NETWORK=fuji

# Deployed ChainPeRegistry contract address (from deployments/<network>.json)
CHAINPE_REGISTRY_ADDRESS=0x91677a35599f052E99Ed0ab9E45c17E736a22Bf6

# Log level: verbose, normal, quiet
CHAINPE_LOG_LEVEL=normal

# ============================================================================
# CONSUMER / AGENT CONFIGURATION (chainpe-wallet MCP, chainpe-agent)
# ============================================================================

# Agent wallet private key (0x...). Used to sign x402 USDC payments.
# In the MCP extension this is stored in the OS keychain, not on disk.
CHAINPE_PRIVATE_KEY=0xYOUR_AGENT_PRIVATE_KEY

# Network: fuji or avalanche
NETWORK=fuji

# Budget limits (USDC)
MAX_PER_CALL=0.10
MAX_PER_DAY=20.00

# ERC-8004 registries (optional — for reading/writing agent reputation)
CHAINPE_REGISTRY_ADDRESS=0x91677a35599f052E99Ed0ab9E45c17E736a22Bf6
ERC8004_IDENTITY_REGISTRY=0x56FEc2359fcDfFa6FA1D3a8AB3b708Ff698161D5
ERC8004_REPUTATION_REGISTRY=0x89476DfEf9c72a668fa5E86f154B73EDB053aFe4

# LLM (chainpe-agent)
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4o
AGENT_LLM_API_KEY=your-api-key

# ============================================================================
# AVALANCHE RESOURCES
# ============================================================================
# Fuji AVAX faucet:   https://faucet.avax.network/
# Fuji USDC faucet:   https://faucet.circle.com  (select Avalanche Fuji)
# Fuji explorer:      https://testnet.snowtrace.io
# Mainnet explorer:   https://snowtrace.io

# ============================================================================
# HOSTED FACILITATOR (Fuji testnet — live on Railway)
# ============================================================================
# Point provider proxies and agents at this:
CHAINPE_FACILITATOR_URL=https://chainpe-facilitator-production.up.railway.app

# ============================================================================
# ARC (CLI) — keep real values in .env only, never commit them
# ============================================================================
CHAINPE_NETWORK=arc-testnet
# Payout wallet key. Its address must equal walletAddress (payTo).
CHAINPE_SELLER_PRIVATE_KEY=
# Buyer key used by `chainpe fetch`. Fund it at https://faucet.circle.com
CHAINPE_PRIVATE_KEY=
# Optional: CLI config file (default ~/.chainpe/config.json)
# CHAINPE_CONFIG=
# Optional: registered Circle account, once the keyless trial is used up
# CIRCLE_API_KEY=
# Optional: RPC overrides
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# ARC_RPC_URL=https://rpc.mainnet.arc.io
