{
  "name": "chainpe-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ChainPe \u2014 x402 payment + ERC-8004 reputation infrastructure for the Avalanche agent economy",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:cli": "npm run build --workspace=@chainpearc/cli",
    "build:agent": "npm run build --workspace=@chainpearc/agent",
    "build:wallet": "npm run build --workspace=@chainpearc/wallet-mcp",
    "build:mcpb": "npm run build:mcpb --workspace=@chainpearc/wallet-mcp",
    "build:sdk": "npm run build --workspace=@chainpearc/sdk",
    "build:ai-tools": "npm run build --workspace=@chainpearc/ai-tools",
    "test:wallet": "npm run test --workspace=@chainpearc/wallet-mcp",
    "test:sdk": "npm run test --workspace=@chainpearc/sdk",
    "test:ai-tools": "npm run test --workspace=@chainpearc/ai-tools",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:a2a": "node e2e/agent-to-agent.mjs",
    "dev": "npm run dev --workspace=@chainpearc/cli",
    "dev:agent": "npm run dev --workspace=@chainpearc/agent",
    
    "dev:dashboard": "npm run dev --prefix apps/dashboard",
    "dev:landing": "npm run dev --prefix apps/landing -- -p 3002",
    "dev:docs": "npm run start --prefix website",
    "dev:all": "npm run dev:docs & npm run dev:landing",
    "dev:docs:rebuild": "cd website && npm run build && rm -rf ../apps/dashboard/public/docs && cp -r build ../apps/dashboard/public/docs && rm -rf ../apps/landing/public/docs && cp -r build ../apps/landing/public/docs",
    
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "publish:cli": "npm publish --workspace=@chainpearc/cli --access public",
    "publish:agent": "npm publish --workspace=@chainpearc/agent --access public",
    "publish:sdk": "npm publish --workspace=@chainpearc/sdk --access public",
    "publish:ai-tools": "npm publish --workspace=@chainpearc/ai-tools --access public",
    "publish:all": "npm run publish:sdk && npm run publish:ai-tools && npm run publish:cli && npm run publish:agent"
  },
  "keywords": [
    "x402",
    "avalanche",
    "ai-agents",
    "agent-economy",
    "micropayments",
    "pay-per-request",
    "http-402",
    "erc-8004",
    "reputation",
    "usdc"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@chainpearc/sdk": "^0.3.0"
  }
}
