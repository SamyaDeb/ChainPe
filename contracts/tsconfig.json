{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./out",
    "rootDir": "./",
    "types": ["node"],
    "plugins": [
      {
        "name": "@algorandfoundation/algorand-typescript/ts-plugin"
      }
    ]
  },
  "include": ["src/**/*.algo.ts"],
  "exclude": ["node_modules", "out"]
}
