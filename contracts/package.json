{
  "name": "@chainpearc/contracts",
  "version": "2.0.0",
  "description": "ChainPe on-chain registry smart contracts for Avalanche C-Chain (Solidity)",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean",
    "deploy:erc8004": "hardhat run scripts/deploy-erc8004.ts --network fuji",
    "deploy:erc8004:mainnet": "hardhat run scripts/deploy-erc8004.ts --network avalanche",
    "deploy:fuji": "hardhat run scripts/deploy.ts --network fuji",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network avalanche",
    "deploy:policyvault:fuji": "hardhat run scripts/deploy-policyvault.ts --network fuji",
    "deploy:policyvault:mainnet": "hardhat run scripts/deploy-policyvault.ts --network avalanche",
    "deploy:icm:fuji": "hardhat run scripts/deploy-icm.ts --network fuji",
    "deploy:icm:mainnet": "hardhat run scripts/deploy-icm.ts --network avalanche",
    "transfer-ownership:fuji": "hardhat run scripts/transfer-ownership.ts --network fuji",
    "transfer-ownership:mainnet": "hardhat run scripts/transfer-ownership.ts --network avalanche",
    "configure-icm:fuji": "hardhat run scripts/configure-icm.ts --network fuji",
    "configure-icm:mainnet": "hardhat run scripts/configure-icm.ts --network avalanche",
    "register-demo:fuji": "hardhat run scripts/register-demo-services.ts --network fuji",
    "register-demo:mainnet": "hardhat run scripts/register-demo-services.ts --network avalanche",
    "check-keys": "ts-node scripts/check-keys.ts",
    "lint:sol": "npx solhint 'contracts/**/*.sol'",
    "verify:fuji": "hardhat run scripts/verify.ts --network fuji",
    "node": "hardhat node"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.0.0",
    "chai": "^4.5.0",
    "dotenv": "^16.5.0",
    "hardhat": "^2.22.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
