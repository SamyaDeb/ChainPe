{
  "version": 1,
  "name": "ChainPe Weather Demo",
  "description": "Current weather and 5-day forecasts for any city, as clean JSON your agent can parse. No API key or signup: pay per call in USDC on Arc over x402, from $0.001 per request.",
  "docsUrl": "https://chainpe-arc-demo-production.up.railway.app/openapi.json",
  "resources": [
    {
      "resource": "https://chainpe-arc-demo-production.up.railway.app/weather",
      "method": "GET",
      "path": "/weather",
      "description": "Current temperature, conditions, humidity and wind for a city",
      "price": "0.001",
      "amountAtomic": "1000",
      "network": "eip155:5042002",
      "payTo": "0x261f058496D81703c858DDFEd201834F0b5f2e73",
      "rails": [
        "gateway"
      ]
    },
    {
      "resource": "https://chainpe-arc-demo-production.up.railway.app/forecast",
      "method": "GET",
      "path": "/forecast",
      "description": "5-day temperature forecast for a city",
      "price": "0.01",
      "amountAtomic": "10000",
      "network": "eip155:5042002",
      "payTo": "0x261f058496D81703c858DDFEd201834F0b5f2e73",
      "rails": [
        "exact",
        "gateway"
      ]
    }
  ]
}