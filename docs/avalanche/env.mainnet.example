# ─── ChainPe — Mainnet Environment Template ─────────────────────────────────
# Copy to .env and fill in real values. NEVER commit this file with real values.
# All secrets must live in Railway / Vercel secret stores or a local .env only.

# ─── Chain / RPC ─────────────────────────────────────────────────────────────
NETWORK=avalanche
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# Optional: upgrade to a paid node (Infura, Alchemy, Ankr) for reliability
# AVALANCHE_RPC_URL=https://avalanche-mainnet.infura.io/v3/<YOUR_KEY>

# ─── Deployer / Contracts ────────────────────────────────────────────────────
# Funded EOA used for contract deployment (≥ 2 AVAX for all contracts).
# ROTATE THIS KEY immediately after deploying and transferring ownership to Safe.
DEPLOYER_PRIVATE_KEY=0x<REPLACE — funded deployer key>

# Gnosis Safe multisig that will own the contracts post-deploy.
# Create at https://app.safe.global and select Avalanche network.
OWNER_ADDRESS=0x<REPLACE — Gnosis Safe address>

# Snowtrace / Routescan API key for contract verification (free tier works).
SNOWTRACE_API_KEY=routescan

# ─── Mainnet contract addresses (fill in after running deploy scripts) ────────
CHAINPE_REGISTRY_ADDRESS=0x<REPLACE — ChainPeRegistryUpgradeable proxy>
ERC8004_IDENTITY_REGISTRY=0x<REPLACE — IdentityRegistry proxy>
ERC8004_REPUTATION_REGISTRY=0x<REPLACE — ReputationRegistry proxy>
ERC8004_VALIDATION_REGISTRY=0x<REPLACE — ValidationRegistry proxy>
POLICY_VAULT_ADDRESS=0x<REPLACE — PolicyVaultUpgradeable proxy>
ICM_RECEIVER_ADDRESS=0x<REPLACE — ChainPeICMReceiver>

# ─── Facilitator (Railway service: chainpe-facilitator-mainnet) ───────────────
# Gas-paying key that submits USDC settlement transactions.
# This key ONLY pays gas — it never holds user funds and cannot move unsigned USDC.
# Fund with ≥ 1 AVAX. The /health endpoint returns 503 when balance < 0.05 AVAX.
FACILITATOR_PRIVATE_KEY=0x<REPLACE — dedicated gas-paying key, never a fund-holding key>

# Comma-separated list of origins allowed to call /verify and /settle from browsers.
# Server-to-server calls (no Origin header) are always allowed.
ALLOWED_ORIGINS=https://chainpe.app,https://dashboard.chainpe.app

# Log level for pino structured logs (info, debug, warn, error).
LOG_LEVEL=info

# PORT is injected by Railway automatically — do not set manually in Railway.
# PORT=4500

# ─── Indexer (Railway service: chainpe-indexer-mainnet) ──────────────────────
# Postgres connection string (Railway Postgres plugin injects this automatically).
DATABASE_URL=postgresql://user:password@host:5432/chainpe_mainnet

# Block to start indexing from. Set to the ChainPeRegistry deploy block
# to avoid scanning the entire chain history on cold start.
START_BLOCK=<REPLACE — ChainPeRegistry deploy block number>

# How often to poll for new blocks (ms). 5000 is safe for Avalanche (~2s block time).
POLL_INTERVAL_MS=5000

# ─── Dashboard (Vercel / Railway) ────────────────────────────────────────────
NEXT_PUBLIC_NETWORK=avalanche
NEXT_PUBLIC_CHAINPE_REGISTRY=0x<REPLACE — same as CHAINPE_REGISTRY_ADDRESS>

# Optional: point at the indexer for ranked search. If unset, dashboard reads on-chain.
INDEXER_URL=https://chainpe-indexer-mainnet.up.railway.app

# ─── ICM cross-chain (optional) ──────────────────────────────────────────────
# Source Avalanche L1 blockchain ID (bytes32 hex) and trusted sender address.
# Only needed if using cross-L1 payment intents. Run configure-icm:mainnet after setting.
# SOURCE_BLOCKCHAIN_ID=0x<bytes32 blockchain ID of the agent's home L1>
# TRUSTED_SENDER=0x<ChainPeICMSender address on that source chain>

# ─── Canonical constants (do not change) ─────────────────────────────────────
# Mainnet USDC (Circle bridged USDC on Avalanche C-Chain)
# USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
# Fuji USDC (Circle test USDC)
# USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# Teleporter (ICM) — same on all Avalanche L1s
# TELEPORTER_MESSENGER=0x253b2784c75e510dD0fF1da844684a1aC0aa5fcf
