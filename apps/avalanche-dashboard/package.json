{
  "name": "chainpe-avalanche-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint --type-aware src scripts --fix; s=$?; oxlint --fix .; exit $((s>0?s:$?))",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npx tsx scripts/test-money.ts && npm run test-x402",
    "test-x402": "npx tsx scripts/test-x402.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.106.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "2.57.5",
    "wagmi": "2.19.5"
  },
  "overrides": {
    "viem": "2.57.5",
    "qr": "0.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5"
  }
}
