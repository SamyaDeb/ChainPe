# Public values only. Nothing here is a secret.

# ChainPe backend (services/chainpe-cloud, Avalanche). Leave empty in development to run on sample data.
VITE_CHAINPE_CLOUD_URL=

# WalletConnect project id. Public, not a secret. src/lib/env.ts holds ChainPe's, so leave this unset.
# Add this dashboard's domain to the project's allowlist at dashboard.reown.com, or set it to empty for no QR code.
# VITE_WALLETCONNECT_PROJECT_ID=

# Set to true to serve sample data from src/mock (shows a "Sample data, not live" banner)
VITE_USE_MOCK=false

# Path prefix the app is served under. Empty or / at the root, or e.g. /dashboard/ to serve under that path.
VITE_BASE_PATH=
