# Public values only. Nothing here is a secret.

# ChainPe backend. Leave empty in development to run on sample data.
VITE_CHAINPE_CLOUD_URL=https://chainpe-cloud-production.up.railway.app

# arc-testnet (the only network this dashboard supports today)
VITE_ARC_NETWORK=arc-testnet

# ChainPeAccounts on Arc testnet
VITE_ACCOUNTS_ADDRESS=0xD315322c9D83A6f50A04236A2a242e0259bfB580

# ChainPeFees on Arc testnet. src/lib/env.ts holds the address, so leave this unset.
# VITE_FEES_ADDRESS=

# USDC on Arc testnet (ERC-20 view, 6 decimals)
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# WalletConnect project id. Public, not a secret. src/lib/env.ts holds ChainPe's, so leave this unset.
# Set it to use another project (add the site's domain to its allowlist), or to empty for no QR code.
# VITE_WALLETCONNECT_PROJECT_ID=

# Set to true to serve sample data from src/mock (shows a "Sample data, not live" banner)
VITE_USE_MOCK=false

# Path prefix the app is served under. Empty or / for the preview and dev server,
# /dashboard/ for the production build at https://chainpe.vercel.app/dashboard
VITE_BASE_PATH=
